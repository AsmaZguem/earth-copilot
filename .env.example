# Copy to .env and adjust.
# LLM provider: ollama (default, local, free) | groq | gemini (free tiers, only for recording the demo)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Only needed for the matching provider
# GROQ_API_KEY=
# GOOGLE_API_KEY=

# Folder = embedded Qdrant, no Docker needed. Use http://localhost:6333 with `docker compose up -d`.
QDRANT_LOCATION=data/qdrant
STAC_URL=https://earth-search.aws.element84.com/v1
MAX_CLOUD_COVER=20
MAX_AREA_KM2=100
